    <string name="settings_status_support_heading">HolyArrs is built by one person, in the open.</string>
    <string name="settings_status_support_p1">Hi, I\'m Luis. I started HolyArrs because I was tired of running six apps to do one job. Now it\'s one app that finds, downloads, subtitles and files your shows and movies, and it\'s free for everyone who runs it.</string>
    <string name="settings_status_support_p2">Behind every install is a metadata server I run and pay for each month. It\'s what fills in your posters, trailers, details and what\'s new. The more people use HolyArrs, the more it costs to keep fast.</string>
    <string name="settings_status_support_does_heading">What your support does</string>
    <string name="settings_status_support_does1">Keeps the metadata server running for every install, including yours</string>
    <string name="settings_status_support_does2">Buys the time to fix bugs and answer reports quickly</string>
    <string name="settings_status_support_does3">Pays for building the features people ask for most</string>
    <string name="settings_status_support_p3_lead">It\'s not only money.</string>
    <string name="settings_status_support_p3">A star on GitHub helps more people find HolyArrs. A kind note, a bug report, or telling a friend about it all help just as much.</string>
    <string name="settings_status_support_p4">Thank you for running HolyArrs. It means a lot.</string>
